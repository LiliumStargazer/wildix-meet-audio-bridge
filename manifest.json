{
  "manifest_version": 3,
  "name": "Wildix Meet Audio Bridge",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Silenzia automaticamente Google Meet durante le chiamate Wildix.",

  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "offscreen"
  ],

  "icons": {
    "128": "icons/icon128.png"
  },

  "host_permissions": [
    "https://automaticmachines.wildixin.com/*",
    "https://meet.google.com/*"
  ],

  "optional_host_permissions": ["https://*/*"],

  "background": {
    "service_worker": "src/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/meet-audio.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/meet.js"
      ],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_title": "Wildix Meet Audio Bridge",
    "default_icon": {
      "16": "icons/icon16-red.png",
      "32": "icons/icon32-red.png"
    },
    "default_popup": "src/popup.html"
  }
}