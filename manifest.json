{
  "manifest_version": 3,
  "name": "Wildix Meet Audio Bridge",
  "version": "0.2.1",
  "description": "Silenzia automaticamente Google Meet durante le chiamate Wildix.",

  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "notifications"
  ],

  "icons": {
    "128": "icons/icon128.png"
  },

  "host_permissions": [
    "https://automaticmachines.wildixin.com/*",
    "https://meet.google.com/*"
  ],

  "background": {
    "service_worker": "src/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://automaticmachines.wildixin.com/*"
      ],
      "js": [
        "src/wildix-rtc.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://automaticmachines.wildixin.com/*"
      ],
      "js": [
        "src/wildix.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/meet.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Wildix Meet Audio Bridge"
  }
}